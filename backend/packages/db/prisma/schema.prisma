generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  displayName  String?
  email        String  @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         String?
  location     String?
  customStatus String?

  githubId       String? @unique
  githubUsername String?
  githubVerified Boolean @default(false)

  profileCompleted Boolean @default(false)

  skills                 UserSkill[]
  githubInstallations    GithubInstallation[]
  ownedRooms             Room[]
  roomMemberships        RoomMember[]
  sentFriendRequests     FriendRequest[]      @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]      @relation("ReceivedFriendRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Owned by User Service. A single row represents the entire lifecycle of
// one friend relationship attempt between two users — accepting or
// rejecting updates the same row rather than creating a new one, so
// there is at most one FriendRequest per ordered (senderId, receiverId)
// pair ever. "Are A and B friends" is answered by querying for a row
// between them (either direction) with status ACCEPTED — no separate
// denormalized Friendship table, since the request row already carries
// everything needed and two sources of truth for the same fact would
// invite drift.
model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model UserSkill {
  id     String @id @default(uuid())
  userId String
  skill  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model GithubInstallation {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId BigInt @unique

  accountLogin String
  accountId    BigInt
  accountType  String // "User" | "Organization"

  suspended Boolean @default(false)
  active    Boolean @default(true) // flipped false on uninstall/revocation

  repositories GithubRepository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GithubRepository {
  id             String             @id @default(uuid())
  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  githubRepositoryId BigInt
  name               String
  fullName           String
  ownerLogin         String
  ownerId            BigInt
  private            Boolean
  defaultBranch      String?
  htmlUrl            String

  room Room?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([installationId, githubRepositoryId])
}

enum RoomRole {
  OWNER
  MEMBER
}

model Room {
  id       String @id @default(uuid())
  name     String
  roomCode String @unique

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  githubRepositoryId String           @unique
  githubRepository   GithubRepository @relation(fields: [githubRepositoryId], references: [id], onDelete: Restrict)

  members  RoomMember[]
  channels Channel[]
  modules  RoomModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomMember {
  id     String   @id @default(uuid())
  roomId String
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoomRole

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

// A room's chat is split into named channels, e.g. #general, #frontend.
// Every room gets exactly one isDefault channel ("general") created
// alongside the room itself — it can never be renamed away from a valid
// name, archived, or deleted, so a room can never end up with zero usable
// channels. createdBy is the user who created it (always the owner for
// non-default channels, enforced at the service layer, not the schema —
// mirrors how ownership authorization elsewhere in this codebase is a
// service-level check, not a DB constraint).
model Channel {
  id          String    @id @default(uuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name        String
  description String?
  icon        String?
  position    Int       @default(0)
  isDefault   Boolean   @default(false)
  archivedAt  DateTime?
  createdBy   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, name])
  @@index([roomId, position])
}

enum RoomModuleType {
  CHAT
  GITHUB_ACTIVITY
  MEMBERS
  TASKS
  NOTES
  RELEASES
}

// What exists inside a room, owner-configurable. One row per (roomId, type)
// — a room can't have two "Tasks" modules today, which matches every
// module type in this initial set being a singleton concept per room.
// config is small, structured, module-specific display/behavior data
// (e.g. a future Tasks module's default view) — never secrets, never raw
// external payloads, same discipline as Message.metadata elsewhere in
// this schema.
model RoomModule {
  id        String         @id @default(uuid())
  roomId    String
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type      RoomModuleType
  name      String
  position  Int            @default(0)
  enabled   Boolean        @default(true)
  config    Json?
  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, type])
  @@index([roomId, position])
}

// Owned by Chat Service. roomId/userId are deliberately plain fields, not
// Prisma relations — Room and User are owned by Room Service/User Service
// respectively, and Chat Service treats them as external identifiers
// verified over HTTP (Room Service's internal membership endpoint), not
// as foreign keys. This avoids a cross-service cascade: deleting a Room
// or User row must never silently cascade-delete chat history.
enum MessageSenderType {
  USER
  SYSTEM
}

model Message {
  id     String @id @default(uuid())
  roomId String

  // Same cross-service-safety reasoning as roomId/userId above — Channel
  // is owned by Room Service, so this is a plain field verified over HTTP
  // (Room Service's internal channel-lookup endpoint), never a Prisma FK.
  // Required on every row; the migration that introduced this column
  // backfilled every pre-existing message into its room's "general"
  // channel before making it NOT NULL, so no historical row was ever left
  // without one.
  channelId String

  // Null only for SYSTEM messages (e.g. GitHub activity) — there is no
  // Commit.ly user to attribute those to, and GitHub actors are never
  // mapped to fake/sentinel userIds. Always non-null for USER messages.
  userId String?

  senderType MessageSenderType @default(USER)

  // Present only on SYSTEM messages. Identifies the normalized event that
  // produced this message (e.g. "github.pull_request.opened") — lets the
  // frontend pick a rendering without re-deriving it from metadata shape.
  systemEventType String?

  // Present only on SYSTEM messages. Small, structured, display-only data
  // (repository id/name, actor login, PR/issue number, URL, etc.) — never
  // the raw GitHub webhook payload.
  metadata Json?

  // Present only on SYSTEM messages created from a Kafka-delivered event
  // (see chat-service/src/modules/kafka). This is the normalized event's
  // `eventId` (Kafka envelope field), NOT GitHub's own X-GitHub-Delivery
  // id — that delivery id only protects webhook ingestion in GitHub
  // Service's in-memory deliveryStore and never reaches Chat Service.
  // The @unique constraint is the actual idempotency mechanism: Kafka
  // does not guarantee exactly-once delivery, so the consumer relies on
  // a unique-constraint violation (not a prior SELECT, which would race
  // under concurrent consumer instances) to detect and safely ignore a
  // duplicate delivery of the same event. Null for every USER message
  // and for any SYSTEM message created outside the Kafka path.
  sourceEventId String? @unique

  // Monotonic tiebreaker for cursor pagination — createdAt alone can collide
  // at millisecond precision under concurrent sends, and UUID ids don't sort
  // in insertion order. sequence always does, with no floating-point/clock
  // hacks involved.
  sequence BigInt @default(autoincrement())

  content String

  // Thread support. A real self-relation (unlike roomId/userId above) is
  // safe here because both sides live in this same service's table — no
  // cross-service cascade risk. onDelete: Cascade means deleting a parent
  // message (soft-delete only ever sets deletedAt in practice, but this
  // guards the hard-delete/test-cleanup path too) removes its replies
  // rather than leaving orphaned rows with a dangling parentMessageId.
  parentMessageId String?
  parentMessage   Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[] @relation("MessageReplies")

  // Denormalized on the parent for O(1) reply-count display without a
  // COUNT(*) on every message list render. Maintained by the service layer
  // (incremented on reply create, decremented on reply delete) rather than
  // a DB trigger, matching this codebase's existing preference for
  // application-level invariants over DB-level ones (see sequence above).
  replyCount Int @default(0)

  // Resolved, real room-member user ids only — never raw client-supplied
  // text. Populated server-side by matching @handles in content against
  // actual RoomMember rows at send/edit time (see mention resolution in
  // message.service.ts). A plain text[] column, not a join table: reads
  // (rendering a message) never need to join, and this scale doesn't
  // warrant an indexed "messages mentioning me" query today.
  mentionedUserIds String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([roomId, createdAt])
  @@index([roomId, sequence])
  @@index([channelId, sequence])
  @@index([parentMessageId])
}

// Owned by Chat Service. A DM conversation is identity-less beyond its
// two participants — there is exactly one conversation for any given
// unordered pair of users, ever, enforced by always storing the pair
// with userAId < userBId (the smaller uuid string first; see
// dm.service.ts's canonical ordering helper) so the unique constraint
// below catches both request orderings as the same row. Like Message's
// roomId/userId, userAId/userBId are plain fields verified over HTTP
// against User Service, never Prisma relations — Chat Service must
// never cascade-delete DM history as a side effect of a User row being
// deleted by a service it doesn't own.
model DmConversation {
  id      String @id @default(uuid())
  userAId String
  userBId String

  messages DmMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// Mirrors Message's shape (content/edit/delete/sequence conventions)
// but scoped to a DmConversation instead of a Room+Channel — deliberately
// a separate model rather than reusing Message with a nullable roomId,
// so a DM can never accidentally satisfy a room-scoped query and a
// room message can never leak into a DM thread. senderId is always a
// real participant of the parent conversation (enforced in dm.service.ts),
// verified the same "never trust client input" way as everywhere else in
// this codebase.
model DmMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String

  content String

  sequence BigInt @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, sequence])
}
