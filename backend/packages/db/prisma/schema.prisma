generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  displayName  String?
  email        String  @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         String?
  location     String?
  customStatus String?

  githubId       String? @unique
  githubUsername String?
  githubVerified Boolean @default(false)

  profileCompleted Boolean @default(false)

  skills              UserSkill[]
  githubInstallations GithubInstallation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSkill {
  id     String @id @default(uuid())
  userId String
  skill  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model GithubInstallation {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId BigInt @unique

  accountLogin String
  accountId    BigInt
  accountType  String // "User" | "Organization"

  suspended Boolean @default(false)
  active    Boolean @default(true) // flipped false on uninstall/revocation

  repositories GithubRepository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GithubRepository {
  id             String             @id @default(uuid())
  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  githubRepositoryId BigInt
  name               String
  fullName           String
  ownerLogin         String
  ownerId            BigInt
  private            Boolean
  defaultBranch      String?
  htmlUrl            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([installationId, githubRepositoryId])
}
