generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  displayName  String?
  email        String  @unique
  passwordHash String
  avatarUrl    String?
  bio          String?
  role         String?
  location     String?
  customStatus String?

  githubId       String? @unique
  githubUsername String?
  githubVerified Boolean @default(false)

  profileCompleted Boolean @default(false)

  skills              UserSkill[]
  githubInstallations GithubInstallation[]
  ownedRooms          Room[]
  roomMemberships     RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSkill {
  id     String @id @default(uuid())
  userId String
  skill  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model GithubInstallation {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId BigInt @unique

  accountLogin String
  accountId    BigInt
  accountType  String // "User" | "Organization"

  suspended Boolean @default(false)
  active    Boolean @default(true) // flipped false on uninstall/revocation

  repositories GithubRepository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GithubRepository {
  id             String             @id @default(uuid())
  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  githubRepositoryId BigInt
  name               String
  fullName           String
  ownerLogin         String
  ownerId            BigInt
  private            Boolean
  defaultBranch      String?
  htmlUrl            String

  room Room?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([installationId, githubRepositoryId])
}

enum RoomRole {
  OWNER
  MEMBER
}

model Room {
  id           String @id @default(uuid())
  name         String
  roomCode     String @unique
  passwordHash String

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  githubRepositoryId String           @unique
  githubRepository   GithubRepository @relation(fields: [githubRepositoryId], references: [id], onDelete: Restrict)

  members RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomMember {
  id     String   @id @default(uuid())
  roomId String
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoomRole

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

// Owned by Chat Service. roomId/userId are deliberately plain fields, not
// Prisma relations — Room and User are owned by Room Service/User Service
// respectively, and Chat Service treats them as external identifiers
// verified over HTTP (Room Service's internal membership endpoint), not
// as foreign keys. This avoids a cross-service cascade: deleting a Room
// or User row must never silently cascade-delete chat history.
enum MessageSenderType {
  USER
  SYSTEM
}

model Message {
  id     String @id @default(uuid())
  roomId String

  // Null only for SYSTEM messages (e.g. GitHub activity) — there is no
  // Commit.ly user to attribute those to, and GitHub actors are never
  // mapped to fake/sentinel userIds. Always non-null for USER messages.
  userId String?

  senderType MessageSenderType @default(USER)

  // Present only on SYSTEM messages. Identifies the normalized event that
  // produced this message (e.g. "github.pull_request.opened") — lets the
  // frontend pick a rendering without re-deriving it from metadata shape.
  systemEventType String?

  // Present only on SYSTEM messages. Small, structured, display-only data
  // (repository id/name, actor login, PR/issue number, URL, etc.) — never
  // the raw GitHub webhook payload.
  metadata Json?

  // Monotonic tiebreaker for cursor pagination — createdAt alone can collide
  // at millisecond precision under concurrent sends, and UUID ids don't sort
  // in insertion order. sequence always does, with no floating-point/clock
  // hacks involved.
  sequence BigInt @default(autoincrement())

  content String

  // Thread support. A real self-relation (unlike roomId/userId above) is
  // safe here because both sides live in this same service's table — no
  // cross-service cascade risk. onDelete: Cascade means deleting a parent
  // message (soft-delete only ever sets deletedAt in practice, but this
  // guards the hard-delete/test-cleanup path too) removes its replies
  // rather than leaving orphaned rows with a dangling parentMessageId.
  parentMessageId String?
  parentMessage   Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         Message[] @relation("MessageReplies")

  // Denormalized on the parent for O(1) reply-count display without a
  // COUNT(*) on every message list render. Maintained by the service layer
  // (incremented on reply create, decremented on reply delete) rather than
  // a DB trigger, matching this codebase's existing preference for
  // application-level invariants over DB-level ones (see sequence above).
  replyCount Int @default(0)

  // Resolved, real room-member user ids only — never raw client-supplied
  // text. Populated server-side by matching @handles in content against
  // actual RoomMember rows at send/edit time (see mention resolution in
  // message.service.ts). A plain text[] column, not a join table: reads
  // (rendering a message) never need to join, and this scale doesn't
  // warrant an indexed "messages mentioning me" query today.
  mentionedUserIds String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([roomId, createdAt])
  @@index([roomId, sequence])
  @@index([parentMessageId])
}
