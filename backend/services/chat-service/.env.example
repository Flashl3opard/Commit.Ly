PORT=4004
NODE_ENV=development
JWT_SECRET=replace-with-shared-jwt-secret
CLIENT_ORIGIN=http://localhost:3000
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
ROOM_SERVICE_URL=http://localhost:4003
USER_SERVICE_URL=http://localhost:4001

# Kafka (optional — see README.md for local KRaft setup). Leave
# KAFKA_BROKERS unset to run without Kafka; every REST/WebSocket path
# still works, only the github.events consumer is not started.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commitly-chat-service
KAFKA_GROUP_ID=commitly-chat-service
KAFKA_GITHUB_EVENTS_TOPIC=github.events
KAFKA_GITHUB_EVENTS_DLQ_TOPIC=github.events.dlq
