PORT=4002
NODE_ENV=development
JWT_SECRET=replace-with-shared-jwt-secret
CLIENT_ORIGIN=http://localhost:3000
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret
USER_SERVICE_URL=http://localhost:4001

# GitHub OAuth (existing identity verification flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:4002/github/callback

# GitHub App (installation / repository access — see GITHUB_APP_SETUP.md)
FRONTEND_URL=http://localhost:3000
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM private key downloaded from the GitHub App settings page.
# Keep it on one line with literal \n sequences, e.g.:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:4002/github/app/callback
